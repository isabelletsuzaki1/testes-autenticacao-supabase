            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        },
        "response": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC02: login rejeitado\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([400, 401, 403, 422]);",
              "});",
              "let resposta = {};",
              "try { resposta = pm.response.json(); } catch (e) {}",
              "pm.test(\"Resposta em JSON\", function () { pm.expect(typeof resposta).to.eql(\"object\"); });",
              "pm.test(\"Nenhum access token retornado\", function () {",
              "  pm.expect(resposta.access_token).to.be.undefined;",
              "});",
              ""
            ]
          }
        }
      ]
    },
